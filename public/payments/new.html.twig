{% extends "layouts/main.html.twig" %}

{% block title %}Registrar Cobro de Servicio - VetMedik{% endblock %}

{% block content %}
<div class="container-fluid px-0">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Registrar Cobro</h2>
      <p class="text-muted mb-0">Liquidación de consultas, cirugías, vacunas y procedimientos veterinarios.</p>
    </div>
    <a href="{{ base_url }}/payments" class="btn btn-sm btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Volver a Pagos
    </a>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <form method="POST" action="{{ base_url }}/payments/create">
        {{ csrf_field() }}

        <div class="mb-3">
          <label class="form-label fw-bold">Seleccionar Cita / Servicio Pendiente *</label>
          <select name="reservation_id" id="reservation_select" class="form-select form-select-sm" required onchange="updatePrice(this)">
            <option value="">-- Selecciona una cita con saldo pendiente --</option>
            {% for r in pending_reservations %}
              {% set pac = r.getPacient() %}
              {% set med = r.getMedic() %}
              <option value="{{ r.id }}" data-price="{{ r.price }}" {{ selected_id == r.id ? 'selected' : '' }}>
                Cita #{{ r.id }} - {{ pac ? pac.name ~ ' (' ~ pac.owner_name ~ ')' : 'S/P' }} - {{ r.title }} (${{ r.price|number_format(2) }})
              </option>
            {% endfor %}
          </select>
        </div>

        <div class="row g-3 mb-3">
          <div class="col-md-6">
            <label class="form-label fw-bold">Monto a Cobrar ($) *</label>
            <div class="input-group input-group-sm">
              <span class="input-group-text">$</span>
              <input type="number" step="0.5" name="amount" id="amount_input" class="form-control fw-bold text-success fs-6" value="{{ selected_reservation ? selected_reservation.price : '0.00' }}" required>
            </div>
          </div>
          <div class="col-md-6">
            <label class="form-label fw-bold">Método de Pago *</label>
            <select name="payment_method" class="form-select form-select-sm" required>
              <option value="Efectivo">Efectivo</option>
              <option value="Tarjeta de Débito">Tarjeta de Débito</option>
              <option value="Tarjeta de Crédito">Tarjeta de Crédito</option>
              <option value="Transferencia">Transferencia Bancaria</option>
            </select>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold">Notas o Folio de Transacción</label>
          <input type="text" name="notes" class="form-control form-control-sm" placeholder="Ej: Pago total de consulta y antibióticos, terminal 4, etc.">
        </div>

        <div class="form-check mb-4">
          <input class="form-check-input" type="checkbox" name="mark_attended" value="1" id="mark_attended" checked>
          <label class="form-check-label fw-semibold" for="mark_attended">
            Marcar la cita como "Atendida / Realizada" automáticamente al liquidar
          </label>
        </div>

        <div class="d-flex justify-content-end gap-2">
          <a href="{{ base_url }}/payments" class="btn btn-sm btn-light">Cancelar</a>
          <button type="submit" class="btn btn-sm btn-success text-white">
            <i class="bi bi-check2-circle me-1"></i> Registrar Pago y Generar Recibo
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function updatePrice(select) {
  var opt = select.options[select.selectedIndex];
  var price = opt.getAttribute('data-price');
  if (price) {
    document.getElementById('amount_input').value = price;
  }
}
</script>
{% endblock %}
