{% extends "layouts/main.html.twig" %}

{% block title %}Panel Principal - VetMedik v2{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item active"><span>Dashboard</span></li>
{% endblock %}

{% block content %}
<div class="container-fluid px-0">
    <!-- Header y Botones de Acción Rápida -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h3 class="fw-bold mb-1 text-dark">
                <i class="bi bi-speedometer2 me-2 text-primary"></i>Panel de Control Veterinario
            </h3>
            <p class="text-body-secondary mb-0">Monitoreo en vivo de consultas, pacientes, ingresos y agenda médica.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ base_url }}/reservation/new" class="btn btn-sm btn-primary shadow-sm">
                <i class="bi bi-calendar-plus me-1"></i> + Agendar Consulta
            </a>
            <a href="{{ base_url }}/pacient/new" class="btn btn-sm btn-info text-white shadow-sm">
                <i class="bi bi-heart-pulse me-1"></i> + Nueva Mascota
            </a>
            <a href="{{ base_url }}/payments/new" class="btn btn-sm btn-success shadow-sm">
                <i class="bi bi-cash-coin me-1"></i> + Registrar Cobro
            </a>
        </div>
    </div>

    <!-- Tarjetas Estadística KPIs (5 Columnas Fluidas) -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4 col-xl">
            <div class="card text-white bg-primary shadow-sm border-0 h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-3 fw-bold">{{ pacients_count }}</div>
                        <div class="small text-white-50 text-uppercase fw-semibold">Mascotas Registradas</div>
                        <a href="{{ base_url }}/pacients" class="text-white text-decoration-none small d-inline-block mt-2">
                            Ver catálogo <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-heart-pulse-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4 col-xl">
            <div class="card text-white bg-info shadow-sm border-0 h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-3 fw-bold">{{ medics_count }}</div>
                        <div class="small text-white-50 text-uppercase fw-semibold">Veterinarios</div>
                        <a href="{{ base_url }}/medics" class="text-white text-decoration-none small d-inline-block mt-2">
                            Ver especialistas <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-person-badge-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-4 col-xl">
            <div class="card text-white bg-warning shadow-sm border-0 h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-3 fw-bold">{{ upcoming_count }}</div>
                        <div class="small text-white-50 text-uppercase fw-semibold">Citas Próximas</div>
                        <a href="{{ base_url }}/reservations" class="text-white text-decoration-none small d-inline-block mt-2">
                            Ver agenda <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-calendar-check-fill"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-6 col-xl">
            <div class="card text-white bg-danger shadow-sm border-0 h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-3 fw-bold">{{ pending_count }}</div>
                        <div class="small text-white-50 text-uppercase fw-semibold">Citas Pendientes</div>
                        <a href="{{ base_url }}/reservations?filter=pending" class="text-white text-decoration-none small d-inline-block mt-2">
                            Atender citas <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-hourglass-split"></i></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-6 col-xl">
            <div class="card text-white bg-success shadow-sm border-0 h-100">
                <div class="card-body p-3 d-flex justify-content-between align-items-center">
                    <div>
                        <div class="fs-3 fw-bold">${{ total_income|number_format(2, '.', ',') }}</div>
                        <div class="small text-white-50 text-uppercase fw-semibold">Recaudación Cobrada</div>
                        <a href="{{ base_url }}/payments" class="text-white text-decoration-none small d-inline-block mt-2">
                            Historial pagos <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                    <div class="fs-1 opacity-50"><i class="bi bi-cash-coin"></i></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Gráficas Estadísticas -->
    <div class="row g-4 mb-4">
        <!-- Gráfica 1: Actividad y Estado de Consultas -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Estatus de Consultas
                    </h6>
                    <span class="badge bg-light text-muted border">Totales Globales</span>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 260px;">
                        <canvas id="chartStatus"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfica 2: Pacientes por Especie -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-pie-chart-fill text-success me-2"></i>Mascotas por Especie
                    </h6>
                    <span class="badge bg-light text-muted border">Distribución</span>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="chartSpecies"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Citas Recientes en Formato de CARDS -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-0 text-dark">
                <i class="bi bi-calendar2-heart text-danger me-2"></i>Consultas y Citas Recientes
            </h5>
            <small class="text-body-secondary">Fichas de atención rápida para pacientes agendados</small>
        </div>
        <a href="{{ base_url }}/reservations" class="btn btn-sm btn-outline-primary shadow-sm rounded-pill px-3">
            <i class="bi bi-list-ul me-1"></i> Ver Toda la Agenda
        </a>
    </div>

    <div class="row g-3 mb-5">
        {% for reservation in recent_reservations %}
            {% set pacient = reservation.getPacient() %}
            {% set medic = reservation.getMedic() %}
            {% set status = reservation.getStatus() %}

            {# Asignar icono según especie #}
            {% set species_icon = 'bi-heart-pulse-fill' %}
            {% if pacient and pacient.species == 'Canino' %}
                {% set species_icon = 'bi-github' %}
            {% elseif pacient and pacient.species == 'Felino' %}
                {% set species_icon = 'bi-emoji-smile-fill' %}
            {% elseif pacient and pacient.species == 'Ave' %}
                {% set species_icon = 'bi-send-fill' %}
            {% endif %}

            <div class="col-md-6 col-xl-4">
                <div class="card h-100 border-0 shadow-sm transition-hover">
                    <!-- Cabecera de la Tarjeta -->
                    <div class="card-header bg-white py-2 px-3 border-bottom d-flex justify-content-between align-items-center">
                        <span class="badge bg-light text-dark border">
                            <i class="bi bi-calendar3 me-1 text-primary"></i>{{ reservation.date_at }}
                            <i class="bi bi-clock ms-2 me-1 text-primary"></i>{{ reservation.time_at }}
                        </span>
                        <span class="badge rounded-pill px-2 py-1 badge-status-{{ reservation.status_id }}">
                            {{ status ? status.name : 'Pendiente' }}
                        </span>
                    </div>

                    <!-- Cuerpo de la Tarjeta -->
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-3">
                            <div class="avatar bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; min-width: 48px;">
                                <i class="bi {{ species_icon }} fs-4"></i>
                            </div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h5 class="card-title mb-0 fw-bold text-truncate">
                                    {% if pacient %}
                                        <a href="{{ base_url }}/pacient/{{ pacient.id }}" class="text-decoration-none text-dark hover-primary" title="Ver historial clínico">
                                            {{ pacient.name }}
                                        </a>
                                    {% else %}
                                        <span class="text-muted">Sin Paciente</span>
                                    {% endif %}
                                </h5>
                                <div class="mt-1 d-flex flex-wrap gap-1">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle small py-0">
                                        {{ pacient ? pacient.species : 'Mascota' }}
                                    </span>
                                    {% if pacient and pacient.breed %}
                                        <span class="badge bg-secondary-subtle text-secondary small py-0">
                                            {{ pacient.breed }}
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>

                        <!-- Info Dueño y Veterinario -->
                        <div class="small mb-3 bg-light rounded p-2 border">
                            <div class="d-flex justify-content-between text-truncate mb-1">
                                <span class="text-muted"><i class="bi bi-person me-1"></i>Dueño:</span>
                                <strong class="text-dark">{{ pacient ? pacient.owner_name : 'No registrado' }}</strong>
                            </div>
                            {% if pacient and pacient.owner_phone %}
                                <div class="d-flex justify-content-between text-truncate mb-1">
                                    <span class="text-muted"><i class="bi bi-telephone me-1"></i>Tel:</span>
                                    <span>{{ pacient.owner_phone }}</span>
                                </div>
                            {% endif %}
                            <div class="d-flex justify-content-between text-truncate">
                                <span class="text-muted"><i class="bi bi-person-badge me-1"></i>MVZ:</span>
                                <span class="fw-semibold text-primary">
                                    {{ medic ? 'Dr(a). ' ~ medic.name ~ ' ' ~ medic.lastname : 'Sin asignar' }}
                                </span>
                            </div>
                        </div>

                        <!-- Motivo / Síntomas -->
                        <div class="small text-muted mb-0">
                            <strong>Motivo:</strong> {{ reservation.title ?: 'Consulta Médica General' }}
                            {% if reservation.symtoms %}
                                <div class="text-truncate text-secondary fst-italic">
                                    "{{ reservation.symtoms }}"
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Pie de la Tarjeta: Costo, Pago y Botones de Acción -->
                    <div class="card-footer bg-white border-top py-2 px-3 d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fs-6 fw-bold text-dark">${{ reservation.price|number_format(2) }}</span>
                            {% if reservation.payment_id == 2 %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle ms-1" style="font-size: 0.7rem;">Pagado</span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 0.7rem;">Pendiente</span>
                            {% endif %}
                        </div>

                        <div class="btn-group">
                            {% if reservation.payment_id != 2 %}
                                <a href="{{ base_url }}/payments/new?reservation_id={{ reservation.id }}" class="btn btn-xs btn-success text-white shadow-sm" title="Cobrar Servicio">
                                    <i class="bi bi-cash-coin"></i> Cobrar
                                </a>
                            {% endif %}
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/pdf" target="_blank" class="btn btn-xs btn-outline-danger" title="Descargar Receta / Ficha">
                                <i class="bi bi-file-earmark-pdf"></i>
                            </a>
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/edit" class="btn btn-xs btn-outline-primary" title="Editar Consulta">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card border-0 shadow-sm p-5 text-center text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-primary opacity-50"></i>
                    <h5 class="fw-bold">No hay consultas próximas agendadas</h5>
                    <p class="small mb-3">Comienza agendando una nueva consulta para cualquier paciente registrado.</p>
                    <div>
                        <a href="{{ base_url }}/reservation/new" class="btn btn-sm btn-primary">
                            <i class="bi bi-calendar-plus me-1"></i> Agendar Nueva Consulta
                        </a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
.transition-hover {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}
.transition-hover:hover {
    transform: translateY(-3px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.12) !important;
}
.hover-primary:hover {
    color: #321fdb !important;
}
</style>
{% endblock %}

{% block scripts %}
<script>
document.addEventListener("DOMContentLoaded", function () {
    // 1. Gráfica de Estatus de Consultas
    const ctxStatus = document.getElementById('chartStatus').getContext('2d');
    new Chart(ctxStatus, {
        type: 'bar',
        data: {
            labels: {{ status_labels|json_encode|raw }},
            datasets: [{
                label: 'Cantidad de Citas',
                data: {{ status_data|json_encode|raw }},
                backgroundColor: [
                    'rgba(249, 177, 21, 0.75)',  // Pendiente
                    'rgba(46, 184, 92, 0.75)',   // Aplicada
                    'rgba(108, 117, 125, 0.75)', // No asistió
                    'rgba(229, 83, 83, 0.75)'    // Cancelada
                ],
                borderColor: [
                    '#f9b115',
                    '#2eb85c',
                    '#6c757d',
                    '#e55353'
                ],
                borderWidth: 1.5,
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { precision: 0 }
                }
            }
        }
    });

    // 2. Gráfica de Mascotas por Especie
    const ctxSpecies = document.getElementById('chartSpecies').getContext('2d');
    new Chart(ctxSpecies, {
        type: 'doughnut',
        data: {
            labels: {{ species_labels|json_encode|raw }},
            datasets: [{
                data: {{ species_data|json_encode|raw }},
                backgroundColor: [
                    '#321fdb',
                    '#f9b115',
                    '#2eb85c',
                    '#e55353',
                    '#39f',
                    '#9da5b1'
                ],
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        boxWidth: 12,
                        padding: 15
                    }
                }
            },
            cutout: '65%'
        }
    });
});
</script>
{% endblock %}
