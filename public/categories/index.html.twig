{% extends "layouts/main.html.twig" %}

{% block title %}Especialidades Veterinarias - VetMedik v2{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><span>Gestión Veterinaria</span></li>
<li class="breadcrumb-item active"><span>Especialidades</span></li>
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Especialidades Veterinarias</h3>
        <p class="text-body-secondary mb-0">Categorías de especialidad para clasificar al personal médico veterinario</p>
    </div>
    <a href="{{ base_url }}/category/new" class="btn btn-sm btn-primary shadow-sm">
        <i class="bi bi-tag-fill me-1"></i> + Nueva Especialidad
    </a>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="bg-body-tertiary">
                    <tr>
                        <th class="ps-3">ID</th>
                        <th>Nombre de la Especialidad</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for category in categories %}
                    <tr>
                        <td class="ps-3 text-body-secondary fw-semibold">#{{ category.id }}</td>
                        <td class="fw-bold"><i class="bi bi-tag me-2 text-primary"></i> {{ category.name }}</td>
                        <td class="text-end pe-3">
                            <a href="{{ base_url }}/category/{{ category.id }}/edit" class="btn btn-xs btn-outline-primary me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form action="{{ base_url }}/category/{{ category.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar esta especialidad?');">
                                {{ csrf_field() }}
                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="3" class="text-center py-4 text-body-secondary">No hay especialidades registradas.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
