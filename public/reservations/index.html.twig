{% extends "layouts/main.html.twig" %}

{% block title %}Agenda de Consultas - VetMedik v2{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><span>Gestión Veterinaria</span></li>
<li class="breadcrumb-item active"><span>Consultas</span></li>
{% endblock %}

{% block content %}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Agenda de Consultas Veterinarias</h3>
        <p class="text-body-secondary mb-0">Control de citas clínicas, vacunaciones y servicios veterinarios</p>
    </div>
    <a href="{{ base_url }}/reservation/new" class="btn btn-sm btn-primary shadow-sm">
        <i class="bi bi-calendar-plus me-1"></i> + Agendar Nueva Consulta
    </a>
</div>

<!-- Filtros rápidos de Citas -->
<div class="mb-4">
    <div class="btn-group shadow-sm rounded-pill overflow-hidden bg-body p-1" role="group">
        <a href="{{ base_url }}/reservations?filter=all" class="btn btn-xs {{ filter == 'all' or not filter ? 'btn-primary text-white' : 'btn-light text-body' }} px-3">Todas las Citas</a>
        <a href="{{ base_url }}/reservations?filter=pending" class="btn btn-xs {{ filter == 'pending' ? 'btn-primary text-white' : 'btn-light text-body' }} px-3">Citas Pendientes</a>
        <a href="{{ base_url }}/reservations?filter=old" class="btn btn-xs {{ filter == 'old' ? 'btn-primary text-white' : 'btn-light text-body' }} px-3">Historial Pasado</a>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle mb-0">
                <thead class="bg-body-tertiary">
                    <tr>
                        <th class="ps-3">Folio</th>
                        <th>Motivo / Asunto</th>
                        <th>Mascota & Dueño</th>
                        <th>Médico Veterinario</th>
                        <th>Fecha y Hora</th>
                        <th>Costo</th>
                        <th>Estatus Cita</th>
                        <th>Pago</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for reservation in reservations %}
                    <tr>
                        <td class="ps-3 fw-bold text-muted">#{{ reservation.id }}</td>
                        <td>
                            <div class="fw-bold">{{ reservation.title ?: 'Consulta General' }}</div>
                            {% if reservation.symtoms %}
                                <small class="text-body-secondary">{{ reservation.symtoms|slice(0, 35) }}...</small>
                            {% endif %}
                        </td>
                        <td>
                            {% set pacient = reservation.getPacient() %}
                            {% if pacient %}
                                <a href="{{ base_url }}/pacient/{{ pacient.id }}" class="text-decoration-none fw-semibold text-primary">
                                    <i class="bi bi-heart me-1"></i>{{ pacient.name }}
                                </a>
                                <div class="small text-body-secondary">
                                    {{ pacient.species ?: 'Mascota' }} ({{ pacient.breed ?: 'Mestizo' }})
                                    {% if pacient.owner_name %}
                                        <br><span class="text-muted"><i class="bi bi-person me-1"></i>{{ pacient.owner_name }}</span>
                                    {% endif %}
                                </div>
                            {% else %}
                                <span class="text-body-secondary">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set medic = reservation.getMedic() %}
                            {% if medic %}
                                <a href="{{ base_url }}/medic/{{ medic.id }}" class="text-decoration-none text-body fw-medium">
                                    Dr(a). {{ medic.name }} {{ medic.lastname }}
                                </a>
                            {% else %}
                                <span class="text-body-secondary">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            <div><i class="bi bi-calendar3 me-1 text-body-secondary"></i> {{ reservation.date_at }}</div>
                            <small class="text-body-secondary"><i class="bi bi-clock me-1"></i> {{ reservation.time_at }}</small>
                        </td>
                        <td class="fw-semibold text-success">${{ reservation.price|number_format(2) }}</td>
                        <td>
                            <!-- Formulario de Cambio Rápido de Estado -->
                            <form action="{{ base_url }}/reservation/{{ reservation.id }}/status" method="POST" class="d-inline">
                                {{ csrf_field() }}
                                <select name="status_id" class="form-select form-select-sm border-0 bg-body-tertiary rounded-pill fw-bold py-0" onchange="this.form.submit()" style="font-size: 0.8rem;">
                                    {% for status in statuses %}
                                        <option value="{{ status.id }}" {{ reservation.status_id == status.id ? 'selected' : '' }}>
                                            {{ status.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </form>
                        </td>
                        <td>
                            {% if reservation.payment_id == 2 %}
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="bi bi-check2-circle me-1"></i>Pagado</span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1"><i class="bi bi-hourglass-split me-1"></i>Pendiente</span>
                            {% endif %}
                        </td>
                        <td class="text-end pe-3">
                            {% if reservation.payment_id != 2 %}
                                <a href="{{ base_url }}/payments/new?reservation_id={{ reservation.id }}" class="btn btn-xs btn-success me-1" title="Registrar Cobro">
                                    <i class="bi bi-cash-coin me-1"></i>Cobrar
                                </a>
                            {% endif %}
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/pdf" class="btn btn-xs btn-outline-danger me-1" target="_blank" title="Imprimir PDF"><i class="bi bi-file-pdf"></i></a>
                            <a href="{{ base_url }}/reservation/{{ reservation.id }}/edit" class="btn btn-xs btn-outline-primary me-1" title="Editar"><i class="bi bi-pencil"></i></a>
                            <form action="{{ base_url }}/reservation/{{ reservation.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas cancelar y eliminar esta cita?');">
                                {{ csrf_field() }}
                                <button type="submit" class="btn btn-xs btn-outline-danger" title="Cancelar / Eliminar"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="9" class="text-center py-4 text-body-secondary">No hay consultas agendadas registradas.</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
