{% extends "layouts/main.html.twig" %}

{% block title %}Mascotas y Pacientes - VetMedik{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Mascotas y Pacientes</h2>
      <p class="text-muted mb-0">Directorio de mascotas, razas, propietarios e historiales clínicos.</p>
    </div>
    <a href="{{ base_url }}/pacient/new" class="btn btn-sm btn-primary">
      <i class="bi bi-plus-lg me-1"></i> Nueva Mascota
    </a>
  </div>

  <div class="card mb-4 border-0 shadow-sm">
    <div class="card-body p-3">
      <form action="{{ base_url }}/pacients" method="GET" class="row g-2">
        <div class="col-md-10">
          <div class="input-group input-group-sm">
            <span class="input-group-text bg-body"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="q" class="form-control" placeholder="Buscar por nombre de mascota, dueño, especie o raza..." value="{{ query }}">
          </div>
        </div>
        <div class="col-md-2">
          <button type="submit" class="btn btn-sm btn-primary w-100"><i class="bi bi-filter me-1"></i> Buscar</button>
        </div>
      </form>
    </div>
  </div>

  <div class="card shadow-sm border-0">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th class="ps-3">Expediente</th>
              <th>Mascota / Paciente</th>
              <th>Especie / Raza</th>
              <th>Sexo</th>
              <th>Peso</th>
              <th>Propietario / Dueño</th>
              <th>Contacto Dueño</th>
              <th class="text-end pe-3">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for pacient in pacients %}
              <tr>
                <td class="ps-3"><span class="badge bg-dark">{{ pacient.no ?: ('VET-' ~ pacient.id) }}</span></td>
                <td class="fw-bold fs-6">
                  <i class="bi bi-heart-fill text-danger me-1"></i>{{ pacient.name }}
                </td>
                <td>
                  <span class="badge bg-info text-dark">{{ pacient.species }}</span>
                  <small class="text-muted ms-1">{{ pacient.breed ?: 'Mestizo' }}</small>
                </td>
                <td>
                  {% if pacient.gender == 'Hembra' or pacient.gender == 'f' %}
                    <span class="badge bg-danger-subtle text-danger border border-danger">Hembra</span>
                  {% else %}
                    <span class="badge bg-primary-subtle text-primary border border-primary">Macho</span>
                  {% endif %}
                </td>
                <td>{{ pacient.weight > 0 ? (pacient.weight ~ ' kg') : '-' }}</td>
                <td class="fw-bold">{{ pacient.owner_name }}</td>
                <td>
                  <div><small><i class="bi bi-telephone me-1 text-muted"></i>{{ pacient.owner_phone ?: '-' }}</small></div>
                  <div><small class="text-muted"><i class="bi bi-envelope me-1"></i>{{ pacient.owner_email ?: '-' }}</small></div>
                </td>
                <td class="text-end pe-3">
                  <a href="{{ base_url }}/pacient/{{ pacient.id }}" class="btn btn-xs btn-outline-info" title="Ver Expediente"><i class="bi bi-eye"></i></a>
                  <a href="{{ base_url }}/pacient/{{ pacient.id }}/edit" class="btn btn-xs btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                  <form action="{{ base_url }}/pacient/{{ pacient.id }}/delete" method="POST" class="d-inline" onsubmit="return confirm('¿Seguro que deseas eliminar este paciente?');">
                    {{ csrf_field() }}
                    <button type="submit" class="btn btn-xs btn-outline-danger" title="Eliminar"><i class="bi bi-trash"></i></button>
                  </form>
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="8" class="text-center py-4 text-muted">No se encontraron mascotas registradas.</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
